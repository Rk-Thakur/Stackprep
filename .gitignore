**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Goldie (store assets / screenshots) output
/goldie/out/
/goldie/*.log

# Screenshot capture artifacts written by simulator/goldie runs
/flutter_*.png

# Environment & secrets
.env
.env.*
*.keystore
*.jks
*.p8
*.p12
key.properties
service-account*.json

# Firebase native config (contains API keys; add your own as templates)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
